# PrintATM Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - URL of the client app
CLIENT_URL=http://localhost:5173

# Session Configuration (minutes)
SESSION_TTL_MINUTES=15

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Razorpay Payment Gateway
# Get keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# UPI Merchant Details (for QR code generation)
UPI_VPA=merchant@upi
UPI_MERCHANT_NAME=PrintATM

# Printer Configuration
PRINTER_NAME=default
# Set to 'true' to use simulated printer (for development)
USE_PRINTER_SIMULATION=true

# Demo Mode — allows frontend "Simulate Payment" button
DEMO_MODE=true
